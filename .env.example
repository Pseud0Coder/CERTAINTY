# Model provider (ADR-0012). Without a key the scripted provider runs and
# the demo stays deterministic, so this file is optional.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Defaults to z-ai/glm-5.3-flash.
# CERTAINTY_MODEL=z-ai/glm-5.3-flash

# Optional kill switch. Set to `off` to force the scripted provider even
# when a key is present. The test suite sets this implicitly by passing no
# provider to the Engine.
# CERTAINTY_LLM=off

# Optional. Defaults to 8331.
# PORT=8331
