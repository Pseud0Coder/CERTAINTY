# Model provider (ADR-0012, ADR-0027). Without a key the scripted provider
# runs and everything stays deterministic, so this file is optional.
# DeepSeek platform (preferred when set): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Optional. Defaults to deepseek-flash (the official name; the old
# deepseek-v4-flash is a retired alias).
# DEEPSEEK_MODEL=deepseek-flash

# OpenRouter (the fallback when DeepSeek yields nothing, or the only
# provider when no DeepSeek key is set): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional. Defaults to deepseek/deepseek-v4.1-flash-1017.
# CERTAINTY_MODEL=deepseek/deepseek-v4.1-flash-1017

# Real deployments (ADR-0027). CERTAINTY_DEMO=off removes the public demo
# accounts; the owner variables create the first account (a recruiter, who
# lands on Screening). Existing accounts are never overwritten.
# CERTAINTY_DEMO=off
# CERTAINTY_OWNER_EMAIL=you@example.com
# CERTAINTY_OWNER_PASSWORD=at-least-10-characters
# CERTAINTY_OWNER_NAME=Your Name
# CERTAINTY_AGENCY_NAME=Your Agency
# CERTAINTY_ADMIN_EMAIL=optional-admin@example.com
# Per-user screenings per 24 hours (cost guard). Defaults to 40.
# CERTAINTY_SCREEN_DAILY_LIMIT=40

# Optional kill switch. Set to `off` to force the scripted provider even
# when a key is present. The test suite sets this implicitly by passing no
# provider to the Engine.
# CERTAINTY_LLM=off

# Optional. Defaults to 8331.
# PORT=8331

# Demo affordances (the demo account list on the login page). On unless set
# to `off`; turn it off for any deployment with real candidates.
# CERTAINTY_DEMO=off

# Optional GitHub token for the portfolio connector. Without it GitHub
# allows 60 anonymous requests an hour per server; a fine-grained token with
# no permissions (public data only) raises that to 5,000.
# GITHUB_TOKEN=

# LiveKit voice (optional). Without these the voice console reports
# livekit_not_configured and text mode still works. The webhook requires the
# same key and secret to verify LiveKit signatures.
# LIVEKIT_URL=wss://<your-project>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
